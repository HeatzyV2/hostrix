[Unit]
Description=Hostrix Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/hostrix/agent.env
WorkingDirectory=/opt/hostrix
ExecStart=/opt/hostrix/bin/hostrix-agent
Restart=on-failure
RestartSec=3
LimitNOFILE=65535
User=root

[Install]
WantedBy=multi-user.target
