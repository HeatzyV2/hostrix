# Hostrix API
HOSTRIX_HTTP_ADDR=:8080
HOSTRIX_PANEL_ORIGIN=http://localhost:3000

# MariaDB
HOSTRIX_DB_HOST=127.0.0.1
HOSTRIX_DB_PORT=3306
HOSTRIX_DB_USER=hostrix
HOSTRIX_DB_PASSWORD=change-me
HOSTRIX_DB_NAME=hostrix

# Auth
HOSTRIX_SESSION_TTL_HOURS=72
HOSTRIX_BCRYPT_COST=12
HOSTRIX_BOOTSTRAP_ADMIN_USERNAME=admin
HOSTRIX_BOOTSTRAP_ADMIN_EMAIL=admin@localhost
HOSTRIX_BOOTSTRAP_ADMIN_PASSWORD=changeme

# Cookie
HOSTRIX_COOKIE_SECURE=false
HOSTRIX_COOKIE_NAME=hostrix_session
